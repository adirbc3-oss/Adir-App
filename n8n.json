            "parameters": {
                "jsCode": "const body = $input.item.json.body;\nconst items = [];\n\nfor (const key of Object.keys(body)) {\n  if (key.startsWith('precio_')) {\n     const id = key.replace('precio_', '');\n     const rawValue = body[key] || \"0\";\n     \n     // NORMALIZAR: Cambia comas por puntos antes de convertir a número\n     const normalizedValue = parseFloat(rawValue.toString().replace(',', '.')); \n\n     items.push({\n       json: {\n         solicitud_id: body.solicitud_id,\n         proveedor_id: body.proveedor_id || null,\n         partida_id: id,\n         precio_ofertado: isNaN(normalizedValue) ? 0 : normalizedValue,\n         comentarios: body['comentario_' + id] || \"\"\n       }\n     });\n  }\n}\nreturn items;\n"
            },
