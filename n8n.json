        {
            "parameters": {
                "operation": "text",
                "binaryPropertyName": "attachment_00",
                "options": {
                    "encoding": "windows1252"
                }
            },
            "name": "Extraer Fichero BC3",
            "type": "n8n-nodes-base.extractFromFile",
            "typeVersion": 1,
            "position": [
                688,
                32
            ],
            "id": "27f16d3f-264a-4fca-986d-1c2ce9dbaad4"
        },
        {
            "parameters": {
                "jsCode": "const binaryData = $input.item.binary || {};\nconst attachmentKey = Object.keys(binaryData).find(k => k.startsWith('attachment')) || null;\nconst infoArchivo = attachmentKey ? binaryData[attachmentKey] : null;\nconst nombreArchivo = infoArchivo ? (infoArchivo.fileName || infoArchivo.filename || infoArchivo.name || \"Presupuesto Sin Titulo\") : \"Presupuesto Sin Titulo\";\nconst tituloLimpio = nombreArchivo.replace(/\\.[^/.]+$/, \"\").trim();\nconst idUnico = tituloLimpio + \"_\" + Math.floor(Date.now() / 1000);\n\n// Buscamos el email del remitente de forma segura\nlet emailRemitente = \"Desconocido\";\ntry {\n    const from = $node[\"EmailRead Imap\"].json.from;\n    emailRemitente = from.value?.[0]?.address || from.text || (typeof from === 'string' ? from : \"Desconocido\");\n} catch (e) {\n    emailRemitente = \"Error en remitente\";\n}\n\n// 2. PARSEO DE CONTENIDO BC3\nconst archivoTexto = $input.item.json.data || \"\";\nconst lines = archivoTexto.split(/\\r?\\n/);\nconst conceptos = {};\nconst relaciones = [];\n\nfor (const line of lines) {\n    if (!line.trim()) continue;\n    const parts = line.split('|');\n    const tag = parts[0];\n\n    if (tag === '~C') {\n        const codigo = parts[1]?.trim() || \"S/C\";\n        let precio = parseFloat(parts[4]?.replace(',', '.') || '0');\n        conceptos[codigo] = { \n            Capítulo: codigo, \n            Descripción: parts[3]?.trim() || 'Sin descripción', \n            Precio: isNaN(precio) ? 0 : precio, \n            conceptos: [] \n        };\n    } else if (tag === '~D') {\n        const padre = parts[1]?.trim();\n        let raw_hijos = parts[2] ? parts[2].trim() : '';\n        if (raw_hijos.endsWith('\\\\')) raw_hijos = raw_hijos.slice(0, -1);\n        const items = raw_hijos.split('\\\\');\n        for (let i = 0; i < items.length; i += 3) {\n            if (items[i]) {\n                relaciones.push([\n                    padre, \n                    items[i].trim(), \n                    parseFloat(items[i+1]?.replace(',', '.') || 1) * parseFloat(items[i+2]?.replace(',', '.') || 0)\n                ]);\n            }\n        }\n    }\n}\n\n// 3. ESTRUCTURAR JERARQUÍA\nconst hijos = new Set();\nfor (const [p, h, q] of relaciones) {\n    if (conceptos[p] && conceptos[h]) {\n        conceptos[p].conceptos.push({ ...conceptos[h], Cantidad: q });\n        hijos.add(h);\n    }\n}\n\n// 4. APLANAR PARA BASE DE DATOS\nconst filas = [];\nconst flatten = (arr) => {\n    for (const c of arr) {\n        if (!c.Capítulo) continue; // Seguridad extra\n        filas.push({ \n            propuesta_id: idUnico, \n            texto_partida: (c.Capítulo || \"S/C\") + '::' + (c.Descripción || \"Sin descripción\"), \n            cantidad: c.Cantidad || 0, \n            precio_base_estimado: c.Precio || 0\n        });\n        if (c.conceptos && c.conceptos.length > 0) {\n            flatten(c.conceptos);\n        }\n    }\n};\n\nconst raices = Object.values(conceptos).filter(c => !hijos.has(c.Capítulo));\nflatten(raices);\n\n// 5. SALIDA FINAL\nreturn [{\n    json: {\n        propuesta_maestra: {\n            Proyecto: idUnico,          \n            cliente: emailRemitente,   \n            estado: 'Pendiente',\n            fecha_recepcion: new Date().toISOString()\n        },\n        partidas_hijas: filas\n    }\n}];\n"
            },
            "name": "Parsear FIEBDC a JSON",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                896,
                32
            ],
            "id": "17c1eca3-f1a2-4b4b-b37a-04f3c91b820e"
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "strict",
                        "version": 3
                    },
                    "conditions": [
                        {
                            "id": "4dde3dd8-154a-413b-9a87-1350777d1863",
