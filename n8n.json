        {
            "parameters": {
                "jsCode": "const solicitud = $(\"Supabase - Leer Solicitud\").first()?.json;\n\n// 0. VALIDAR EXISTENCIA\nif (!solicitud) {\n  return [{ json: { html: `\n    <!DOCTYPE html><html><body style=\"text-align:center; padding:50px; font-family:sans-serif;\">\n    <h1 style=\"color:#dc2626;\">Enlace no válido</h1>\n    <p>Lo sentimos, no hemos podido encontrar los detalles de esta solicitud.</p>\n    <p style=\"color:#666;\">Por favor, contacte con ADIR si cree que es un error.</p></body></html>` } }];\n}\n\n// 1. ANULAR ENLACE SI YA HA SIDO RESPONDIDO\nif (solicitud.estado === 'Respondido') {\n  return [{ json: { html: `\n    <!DOCTYPE html><html><body style=\"text-align:center; padding:50px; font-family:sans-serif;\">\n    <h1 style=\"color:#1d4ed8;\">Solicitud Cerrada</h1>\n    <p>Este presupuesto ya ha sido enviado anteriormente. No es posible editarlo.</p>\n    <p style=\"color:#666;\">Gracias por su colaboración.</p></body></html>` } }];\n}\n\n// 2. FILTRAR PARTIDAS\nconst inputItems = $input.all();\nconst partidas = inputItems.length > 0 ? inputItems.map(i => i.json) : [];\nconst normalize = (str) => str ? str.trim().toLowerCase().normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\") : \"\";\nconst buscado = normalize(solicitud.oficio_solicitado);\n\nconst partidasFiltradas = partidas.filter(p => \n  normalize(p.oficio_necesario) === buscado || \n  normalize(p.oficio_asignado) === buscado\n);\n\nlet contentHtml = \"\";\nif (partidasFiltradas.length === 0) {\n  contentHtml = `<div style=\"padding:40px; text-align:center; background:#fff3cd; color:#856404; border-radius:8px;\">\n    <h3>No hay partidas asignadas</h3>\n    <p>No se han encontrado partidas específicas para el oficio: <strong>${solicitud.oficio_solicitado}</strong> en este proyecto.</p>\n  </div>`;\n} else {\n  const filasHtml = partidasFiltradas.map(p => `\n    <tr>\n      <td style=\"padding:10px; border-bottom:1px solid #ddd;\">${p.texto_descripcion || p.texto_partida || 'Sin descripción'}</td>\n      <td style=\"padding:10px; border-bottom:1px solid #ddd; text-align:center;\">${p.unidad || 'ud'}</td>\n      <td style=\"padding:10px; border-bottom:1px solid #ddd; text-align:right;\">${p.cantidad || 1}</td>\n      <td style=\"padding:10px; border-bottom:1px solid #ddd; text-align:right;\">\n        <input type=\"text\" name=\"precio_${p.id}\" required style=\"padding:8px; width:80px; text-align:right; border:1px solid #ccc; border-radius:4px;\">\n      </td>\n      <td style=\"padding:10px; border-bottom:1px solid #ddd;\">\n        <input type=\"text\" name=\"comentario_${p.id}\" placeholder=\"Nota...\" style=\"padding:8px; width:120px; border:1px solid #ccc; border-radius:4px;\">\n      </td>\n    </tr>\n  `).join('');\n\n  contentHtml = `\n    <form action=\"http://localhost:5678/webhook/fase5-procesar\" method=\"POST\">\n      <input type=\"hidden\" name=\"solicitud_id\" value=\"${solicitud.id}\">\n      <input type=\"hidden\" name=\"proveedor_id\" value=\"${solicitud.proveedor_id || ''}\">\n      <table style=\"width:100%; border-collapse: collapse;\">\n        <thead><tr style=\"background:#e9ecef;\"><th style=\"padding:10px; text-align:left;\">Descripción</th><th style=\"padding:10px; text-align:center;\">Unidad</th><th style=\"padding:10px; text-align:right;\">Cant.</th><th style=\"padding:10px; text-align:right;\">Precio (€)</th><th style=\"padding:10px; text-align:left;\">Obs.</th></tr></thead>\n        <tbody>${filasHtml}</tbody>\n      </table>\n      <div style=\"text-align: right; margin-top: 20px;\">\n        <button type=\"submit\" style=\"padding:12px 24px; background:#0d6efd; color:white; border:none; border-radius:4px; font-weight:bold; cursor:pointer;\">Enviar Presupuesto Oficial</button>\n      </div></form>`;\n}\n\nconst html = `\n<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>Portal Proveedor</title></head>\n<body style=\"font-family: system-ui, sans-serif; max-width: 900px; margin: 40px auto; padding: 20px;\">\n  <h1 style=\"color: #1d4ed8;\">Portal de Presupuestos - ADIR</h1>\n  <div style=\"background: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 20px;\">\n    <h3>Hola, ${solicitud.proveedor_nombre || 'Proveedor'}</h3>\n    <p>Por favor, indica tu precio y cualquier observación para <strong>${solicitud.oficio_solicitado}</strong>.</p>\n  </div>\n  ${contentHtml}\n</body></html>`;\n\nreturn [{ json: { html } }];\n"
            },
